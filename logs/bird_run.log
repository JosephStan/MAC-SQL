```sql
-- Find the address of the school with the lowest excellence rate
WITH ExcellenceRates AS (
  SELECT cds, (CAST(NumGE1500 AS REAL) / NumTstTakr) AS ExcellenceRate
  FROM satscores
  WHERE NumTstTakr IS NOT NULL AND NumTstTakr > 0
),
MinExcellence AS (
  SELECT cds
  FROM ExcellenceRates
  ORDER BY ExcellenceRate ASC
  LIMIT 1
)
SELECT s.Street, s.City, s.Zip, s.State
FROM schools s
JOIN MinExcellence me ON s.CDSCode = me.cds;
```

