```sql
-- Corrected SQL to list school names and addresses with more than 30 enrollment difference
SELECT 
  s.`School`,
  s.`Street`,
  s.`StreetAbr`
FROM schools s
JOIN frpm f ON s.`CDSCode` = f.`CDSCode`
WHERE ABS(f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)`) > 30
```

