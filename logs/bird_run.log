```sql
SELECT-- Corrected SQL with proper quoting for SQLite
SELECT 
    T1."CDSCode", 
    CAST(T1."FRPM Count (K-12)" AS REAL) / T1."Enrollment (K-12)" AS EligibleFreeReducedMealRate
FROM 
    schools AS T1
WHERE 
    T1."CDSCode" IN (
        SELECT 
            T2."CDSCode"
        FROM 
            schools AS T2
        WHERE 
            T2."SOC" = 66
        ORDER BY 
