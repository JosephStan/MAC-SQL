```sql
SELECT schools.`School`, 
       (frpm.`Free Meal Count (Ages 5-17)` / frpm.`Enrollment (Ages 5-17)`) AS free_rate
  FROM schools
  INNER JOIN frpm ON schools.`CDSCode` = frpm.`CDSCode`
