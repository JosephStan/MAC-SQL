```sql
-- Fixing the SQL to correctly select only necessary columns and correct the column name for school name
SELECT T1.`CDSCode`, T2.`School`, T1.`AvgReadScore`
FROM (
    SELECT T1.`CDSCode`, AVG(T2.`AvgScrRead`) AS `AvgReadScore`
    FROM (
        SELECT `CDSCode`
        FROM schools
        WHERE `Virtual` = 'F'
    ) AS T1
    INNER JOIN satscores AS T2
        ON T1.`CDSCode` = T2.`cds`
    WHERE T2.`AvgScrRead` IS NOT NULL
    GROUP BY T1.`CDSCode`
) AS T1
INNER JOIN schools AS T2
    ON T1.`CDSCode` = T2.`CDSCode`
ORDER BY T1.`AvgReadScore` DESC
LIMIT 5;
```

