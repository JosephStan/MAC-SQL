```sql
-- Find the CDSCode of the school with the 333rd highest average writing score
WITH RankedScores AS (
  SELECT 
    cds,
    ROW_NUMBER() OVER (ORDER BY AvgScrWrite DESC) AS rank
  FROM satscores
  WHERE AvgScrWrite IS NOT NULL
)
SELECT 
  s.Phone,
  s.Ext
FROM schools s
WHERE s.CDSCode = (
  SELECT cds
  FROM RankedScores
  WHERE rank = 333
)
