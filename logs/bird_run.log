-- Fixing the SQL to correctly select the 10th and 11th schools with highest enrollment for grades 1-12
WITH RankedSchools AS (
    SELECT 
        "CDSCode",
        ROW_NUMBER() OVER (ORDER BY "Enrollment (K-12)" DESC) AS rn
    FROM "schools"
    WHERE "Enrollment (K-12)" IS NOT NULL
