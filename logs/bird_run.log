          WHERE `account_id` IN (
            SELECT `account_id`
              FROM disp
              WHERE `client_id` = (
                SELECT `client_id`
                  FROM loan
                  ORDER BY `amount` DESC
                  LIMIT 1
              )
          )
      )
  )
```

