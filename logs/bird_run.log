SELECT `Low Grade`
  FROM schools
  WHERE `State` = 'CA'
  AND `School` = (
    SELECT `School`
      FROM schools
      WHERE `State` = 'CA'
      ORDER BY `Latitude` ASC
      LIMIT 1
  )
