  SELECT cds, (CAST(NumGE1500 AS REAL) / NumTstTakr) AS ExcellenceRate
  FROM satscores
  WHERE NumTstTakr IS NOT NULL AND NumTstTakr > 0
  ORDER BY ExcellenceRate ASC
