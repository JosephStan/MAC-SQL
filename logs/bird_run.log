```sql
-- Step 1: Calculate the average difference between Enrollment (K-12) and Enrollment (Ages 5-17) for locally funded schools
WITH avg_diff AS (
    SELECT AVG(T1.`Enrollment (K-12)` - T1.`Enrollment (Ages 5-17)`) AS value
    FROM schools AS T1
    WHERE T1.`FundingType` = 'Locally funded'
)

-- Step 2: Select school names and DOC type for schools with difference above the average
SELECT T1.`School`, T1.`DOCType`
FROM schools AS T1, avg_diff
WHERE T1.`FundingType` = 'Locally funded'
  AND (T1.`Enrollment (K-12)` - T1.`Enrollment (Ages 5-17)`) > avg_diff.value;
```

