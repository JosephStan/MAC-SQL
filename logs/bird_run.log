  FROM schools
  WHERE CDSCode IN (
    SELECT CDSCode
      FROM schools
      WHERE EILCode = 'HS'
        AND County = 'Merced'
        AND EdOpsCode = 'LUNCHPROV2'
        AND LowGrade = '9'
        AND HighGrade = '12'
  )
```

