```sql
SELECT T2.`Website`, T2.`School`
FROM schools AS T2
WHERE T2.`CDSCode` IN (
    SELECT T1.`CDSCode`
    FROM schools AS T1
    WHERE T1.`Free Meal Count (Ages 5-17)` BETWEEN 1900 AND 2000
)
```

