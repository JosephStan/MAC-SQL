SQL
```sql
SELECT `sname`, `dname`, `cname`, `enroll12`, `NumTstTakr`, `AvgScrRead`
FROM satscores
WHERE `AvgScrRead` IS NOT NULL
ORDER BY `AvgScrRead` ASC
