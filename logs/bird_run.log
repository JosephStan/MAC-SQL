```sql
-- Fixing the column names with proper quoting
SELECT CDSCode
FROM (
    SELECT CDSCode, 
           ("Enrollment (K-12)" + "Enrollment (Ages 5-17)") AS TotalEnrollment
    FROM frpm
    WHERE "Enrollment (K-12)" IS NOT NULL AND "Enrollment (Ages 5-17)" IS NOT NULL
) AS sub
WHERE TotalEnrollment > 500;
```

**Additional note:**  
