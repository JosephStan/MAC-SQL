  FROM client AS T1
  INNER JOIN account AS T2
  ON T1.`client_id` = T2.`account_id`
  WHERE T1.`gender` = 'F'
    AND T1.`birth_date` < '1950-01-01'
    AND T1.`district_id` = (
      SELECT `district_id`
        FROM district
        WHERE `A2` = 'Slokolov'
    )
```

