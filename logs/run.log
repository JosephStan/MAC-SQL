# Table: continents
[
  (ContId, cont id.),
  (Continent, continent. Value examples: ['europe', 'australia', 'asia', 'america', 'africa'].)
]
# Table: countries
[
  (CountryId, country id.),
  (CountryName, country name. Value examples: ['usa', 'uk', 'sweden', 'russia', 'nigeria', 'new zealand'].),
  (Continent, continent.)
]
# Table: car_makers
[
  (Id, id.),
  (Maker, maker. Value examples: ['volvo', 'volkswagen', 'triumph', 'toyota', 'subaru', 'saab'].),
  (FullName, full name. Value examples: ['Volvo', 'Volkswagen', 'Triumph', 'Toyota', 'Subaru', 'Saab'].),
  (Country, country.)
]
# Table: model_list
[
  (ModelId, model id.),
  (Maker, maker.),
  (Model, model.)
]
# Table: car_names
[
  (MakeId, make id.),
  (Model, model.),
  (Make, make. Value examples: ['ford pinto', 'toyota corolla', 'ford maverick', 'amc matador', 'toyota corona', 'peugeot 504'].)
]
# Table: cars_data
[
  (Id, id.),
  (MPG, mpg. Value examples: ['13', '14', '18', '15', '26', '16'].),
  (Cylinders, cylinders. Value examples: [4, 8, 6, 3, 5].),
  (Edispl, edispl.),
  (Horsepower, horsepower. Value examples: ['150', '90', '88', '110', '100', '95'].),
  (Weight, weight.),
  (Accelerate, accelerate.),
  (Year, year.)
]
【Foreign keys】
countries.`Continent` = continents.`ContId`
car_makers.`Country` = countries.`CountryId`
model_list.`Maker` = car_makers.`Id`
car_names.`Model` = model_list.`Model`
cars_data.`Id` = car_names.`MakeId`
【Question】
Find countries such that, for every car maker in that country, there exists at least one model whose horsepower is greater than every model made by Japan.

SQL



====================

```sql
SELECT DISTINCT c.CountryName
FROM countries c
WHERE NOT EXISTS (
    SELECT *
    FROM car_makers cm
    WHERE cm.Country = c.CountryId
    AND NOT EXISTS (
        SELECT *
        FROM model_list ml
        JOIN car_names cn ON ml.Model = cn.Model
        JOIN cars_data cd ON cn.MakeId = cd.Id
        WHERE ml.Maker = cm.Id
        AND cd.Horsepower > ALL (
            SELECT cd2.Horsepower
            FROM car_names cn2
            JOIN cars_data cd2 ON cn2.MakeId = cd2.Id
            JOIN model_list ml2 ON cn2.Model = ml2.Model
            JOIN car_makers cm2 ON ml2.Maker = cm2.Id
            JOIN countries c2 ON cm2.Country = c2.CountryId
            WHERE c2.CountryName = 'Japan'
        )
    )
)
```

