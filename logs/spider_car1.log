    "SELECT light_models.Model FROM (SELECT Model FROM cars_data JOIN car_names ON cars_data.Id = car_names.MakeId WHERE Weight < 3500) as light_models LEFT JOIN (SELECT Model FROM car_makers JOIN model_list ON car_makers.Id = model_list.Maker WHERE FullName = 'Ford Motor Company') as ford_models ON light_models.Model = ford_models.Model WHERE ford_models.Model IS NULL"
  ],
  "final_sql": "SELECT light_models.Model FROM (SELECT Model FROM cars_data JOIN car_names ON cars_data.Id = car_names.MakeId WHERE Weight < 3500) as light_models LEFT JOIN (SELECT Model FROM car_makers JOIN model_list ON car_makers.Id = model_list.Maker WHERE FullName = 'Ford Motor Company') as ford_models ON light_models.Model = ford_models.Model WHERE ford_models.Model IS NULL"
}

